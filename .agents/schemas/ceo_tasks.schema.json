{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AutonomousCEOGeneratedTasks",
  "type": "object",
  "required": ["strategicSummary", "newTasks"],
  "properties": {
    "strategicSummary": {
      "type": "string",
      "description": "Why these tasks were prioritized based on the current state of PRODUCT_CAPABILITIES.md and the repository."
    },
    "newTasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "domain",
          "description",
          "ownerRole",
          "priority",
          "status",
          "dependencies",
          "affectedPaths",
          "acceptanceCriteria",
          "verificationCommands",
          "riskAssessment"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "domain": {
            "type": "string",
            "enum": [
              "Identity",
              "Social Graph",
              "Places",
              "Experiences",
              "Discovery",
              "Collections",
              "Trust & Safety",
              "Engagement",
              "Platform"
            ]
          },
          "description": { "type": "string" },
          "ownerRole": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
          "status": { "type": "string", "enum": ["READY", "BACKLOG"] },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "affectedPaths": { "type": "array", "items": { "type": "string" } },
          "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
          "verificationCommands": { "type": "array", "items": { "type": "string" } },
          "riskAssessment": { "type": "string" }
        }
      }
    }
  }
}
