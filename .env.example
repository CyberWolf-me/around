# Around — Build-Time Environment Configuration Template (P12-01)
# Copy this file to `.env` (gitignored) and pass via:
#   flutter run --dart-define-from-file=.env
#
# SECURITY WARNING:
# - NEVER place the Supabase `service_role` secret key in this file or in any client build.
# - `SUPABASE_ANON_KEY` must be the public/publishable anon key enforced by PostgreSQL RLS.

ENV=dev
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
DEEP_LINK_DOMAIN=dev.around.tashkent.app
API_TIMEOUT_SECONDS=30
MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
