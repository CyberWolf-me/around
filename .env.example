# Around — Build-Time Environment Configuration Template (TASK-05)
# Copy this file to `.env` (which is gitignored) and pass via:
#   flutter run --dart-define-from-file=.env
#
# SECURITY WARNING:
# - NEVER place the Supabase `service_role` secret key in this file or in any client build.
# - `SUPABASE_ANON_KEY` must be the public/publishable anon key enforced by PostgreSQL RLS.

APP_ENV=development
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key-here
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
