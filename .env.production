# Around — Production Environment Configuration Template (P12-01)
# Pass via: flutter build apk --dart-define-from-file=.env.production
#
# SECURITY WARNING:
# - NEVER embed Supabase service_role keys.
# - SUPABASE_ANON_KEY must be the publishable client key protected by PostgreSQL RLS.

ENV=production
SUPABASE_URL=https://prod-project-ref.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key-here
DEEP_LINK_DOMAIN=around.tashkent.app
API_TIMEOUT_SECONDS=15
MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
